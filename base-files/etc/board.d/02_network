. /lib/functions/system.sh
. /lib/functions/uci-defaults.sh
. /lib/functions/econet.sh

econet_setup_interfaces()
{
	local board="$1"

	case "$board" in
	cmhk,gs2210)
		# The driver splits the integrated switch into a LAN and a WAN
		# VLAN, but only frames from the WAN socket are tagged on their
		# way to the CPU port. LAN therefore stays on plain eth0 and the
		# WAN socket shows up as the eth0.2 VLAN device. See patch
		# 100-gsw-lan-wan-vlan.patch in the econet-eth package: the WAN
		# socket is switch port 0, the LAN sockets are ports 1, 2 and 3,
		# and port 4 is the footprint of an unpopulated socket.
		ucidef_set_interface_lan "eth0"
		ucidef_set_interface_wan "eth0.2"
		;;
	*)
		# econet lacks DSA support now
		ucidef_set_interface_lan "eth0"
		;;
	esac
}

econet_setup_macs()
{
	local board="$1"
	local lan_mac=""
	local wan_mac=""
	local label_mac=""

	case "$board" in
	chinamobile,gs3101)
		wan_mac="$(get_mac_gs3101)"
		[ -n "$wan_mac" ] && lan_mac="$(macaddr_add $wan_mac 1)"
		;;
	huawei,hg2821t-u)
		local conffile="/tmp/configuration_a/factory.conf"
		lan_mac=$(get_mac_ascii "$conffile" brmac)
		wan_mac=$(get_mac_ascii "$conffile" internetmac)
		label_mac=$wan_mac
		;;
	esac

	[ -n "$lan_mac" ] && ucidef_set_interface_macaddr "lan" "$lan_mac"
	[ -n "$wan_mac" ] && ucidef_set_interface_macaddr "wan" "$wan_mac"
	[ -n "$label_mac" ] && ucidef_set_label_macaddr "$label_mac"
}

board_config_update
board=$(board_name)
econet_setup_interfaces $board
econet_setup_macs $board
board_config_flush

exit 0

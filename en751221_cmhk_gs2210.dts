/dts-v1/;

#include "en751221.dtsi"
#include <dt-bindings/input/input.h>
#include <dt-bindings/gpio/gpio.h>

/ {
	model = "China Mobile HK GS2210";
	compatible = "cmhk,gs2210", "econet,en751221";

	/* =====================================================================
	 * 🎯 物理對齊一：完美對齊原廠 440MB 滿血線性記憶體起跑點！
	 * ===================================================================== */
	memory@20000 {
		device_type = "memory";
		reg = <0x00020000 0x1b7e0000>; 
	};

	chosen {
		stdout-path = "/serial@1fbf0000:115200";
	};

	gpio-leds {
		compatible = "gpio-leds";
		power { label = "green:power"; gpios = <&gpio0 16 GPIO_ACTIVE_HIGH>; default-state = "on"; };
		wan { label = "green:wan"; gpios = <&gpio0 6 GPIO_ACTIVE_HIGH>; };
		wlan2g { label = "green:wlan2g"; gpios = <&gpio0 28 GPIO_ACTIVE_HIGH>; };
		wlan5g { label = "green:wlan5g"; gpios = <&gpio0 3 GPIO_ACTIVE_HIGH>; };
		wps { label = "green:wps"; gpios = <&gpio0 41 GPIO_ACTIVE_HIGH>; };
	};

	gpio-keys {
		compatible = "gpio-keys";
		reset { label = "reset"; gpios = <&gpio0 5 GPIO_ACTIVE_LOW>; linux,code = <KEY_RESTART>; };
	};
};

&nand {
	status = "okay";
	econet,bmt;

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		/* =====================================================================
		 * 🛠️ 物理對齊二：將 u-boot 註冊為 NVMEM 提供者，精準誘捕出廠 MAC 坐標！
		 * ===================================================================== */
		partition@0 {
			label = "u-boot";
			reg = <0x0 0x40000>;
			read-only;

			compatible = "nvmem-cells";
			#address-cells = <1>;
			#size-cells = <1>;

			# 👈 核心關鍵：原廠日誌指明偏移量在 ff48，長度為 6 字节
			macaddr_bootloader_ff48: macaddr@ff48 {
				reg = <0xff48 0x6>;
			};
		};

		partition@40000 { label = "romfile"; reg = <0x40000 0x40000>; };
		partition@80000 { label = "tclinux"; reg = <0x80000 0x1000000>; econet,enable-remap; };
		partition@1080000 { label = "tclinux_slave"; reg = <0x1080000 0x1000000>; read-only; };
		partition@2080000 { label = "osgi"; reg = <0x2080000 0x3400000>; };
		partition@5480000 { label = "yaffs"; reg = <0x5480000 0x8000000>; };
		partition@d480000 { label = "upgradeflag"; reg = <0xd480000 0x20000>; };
	};
};

/* =====================================================================
 * 👑 【物理對齊三】強行綁定 GMAC0 總線，並自動注入抓取到的原廠實體 MAC！
 * ===================================================================== */
&ethernet {
	status = "okay";

	gmac0: mac@0 {
		status = "okay";
		phy-mode = "trgmii";
		
		# 👈 自動與上方 U-Boot 分區的 ff48 晶格握手，開機直接繼承原廠合法 MAC！
		nvmem-cells = <&macaddr_bootloader_ff48>;
		nvmem-cell-names = "mac-address";
	};

	mdio-bus {
		switch0: switch@1f {
			status = "okay";
			ports {
				#address-cells = <1>;
				#size-cells = <0>;
				reg = <0>;

				port@0 { status = "disabled"; reg = <0>; };

				/* 精準重定向：內部 Port 1-3 對齊物理網口 LAN1-3 */
				port@1 { status = "okay"; reg = <1>; label = "lan1"; };
				port@2 { status = "okay"; reg = <2>; label = "lan2"; };
				port@3 { status = "okay"; reg = <3>; label = "lan3"; };

				/* CPU 數據總線與 gmac0 進行物理嚙合 */
				port@6 {
					status = "okay";
					reg = <6>;
					label = "cpu";
					ethernet = <&gmac0>;
					phy-mode = "trgmii";
					fixed-link {
						speed = <1000>;
						full-duplex;
					};
				};
			};
		};
	};
};

&uart { status = "okay"; };
&pcie0 { status = "okay"; };
&slot0 { wifi@0,0 { compatible = "mediatek,mt76"; reg = <0x0000 0 0 0 0>; }; };
&pcie1 { status = "okay"; };
&slot1 { wifi@0,0 { compatible = "mediatek,mt76"; reg = <0x0000 0 0 0 0>; }; };

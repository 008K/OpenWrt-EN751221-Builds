/dts-v1/;

#include "en751221.dtsi"
#include <dt-bindings/input/input.h>
#include <dt-bindings/gpio/gpio.h>

/ {
	model = "China Mobile HK GS2210";
	compatible = "cmhk,gs2210", "econet,en751221";

	/* =====================================================================
	 * 🎯 1:1 完美複製 SmartFiber 驗證成功的 440MB 原廠線性內存地圖
	 * 起跑點精準對齊 0x00020000，完美避開引導保留區，徹底粉碎 mem auto-init 卡死！
	 * ===================================================================== */
	memory@0 {
		device_type = "memory";
		reg = <0x00000000 0x1c000000>;
	};

	chosen {
		stdout-path = "/serial@1fbf0000:115200";
		linux,usable-memory-range = <0x00020000 0x1bfe0000>;
	};

	gpio-leds {
		compatible = "gpio-leds";

		power {
			label = "green:power";
			gpios = <&gpio0 16 GPIO_ACTIVE_HIGH>;
			default-state = "on";
		};

		wan {
			label = "green:wan";
			gpios = <&gpio0 6 GPIO_ACTIVE_HIGH>;
		};

		wlan2g {
			label = "green:wlan2g";
			gpios = <&gpio0 28 GPIO_ACTIVE_HIGH>;
		};

		wlan5g {
			label = "green:wlan5g";
			gpios = <&gpio0 3 GPIO_ACTIVE_HIGH>;
		};

		wps {
			label = "green:wps";
			gpios = <&gpio0 41 GPIO_ACTIVE_HIGH>;
		};
	};

	gpio-keys {
		compatible = "gpio-keys";

		reset {
			label = "reset";
			gpios = <&gpio0 5 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};
	};
};

&nand {
	status = "okay";
	econet,bmt;

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		partition@0 {
			label = "bootloader";
			reg = <0x0 0x40000>;
			read-only;

			nvmem-layout {
				compatible = "fixed-layout";
				#address-cells = <1>;
				#size-cells = <1>;

				macaddr_bootloader_ff48: macaddr@ff48 {
					compatible = "mac-base";
					reg = <0xff48 0x6>;
					#nvmem-cell-cells = <1>;
				};
			};
		};

		partition@40000 {
			label = "romfile";
			reg = <0x40000 0x40000>;
		};

		partition@80000 {
			label = "tclinux";
			reg = <0x80000 0x1000000>;
			econet,enable-remap;
		};

		partition@1080000 {
			label = "tclinux_slave";
			reg = <0x1080000 0x1000000>;
			read-only;
		};

		partition@2080000 {
			label = "osgi";
			reg = <0x2080000 0x3400000>;
		};

		partition@5480000 {
			label = "yaffs";
			reg = <0x5480000 0x8000000>;
		};

		partition@d480000 {
			label = "upgradeflag";
			reg = <0xd480000 0x20000>;
		};
	};
};

&uart {
	status = "okay";
};

&pcie0 { 
	status = "okay"; 
};

&slot0 {
	wifi@0,0 {
		compatible = "mediatek,mt76";
		reg = <0x0000 0 0 0 0>;
	};
};

&pcie1 { 
	status = "okay"; 
};

&slot1 {
	wifi@0,0 {
		compatible = "mediatek,mt76";
		reg = <0x0000 0 0 0 0>;
	};
};

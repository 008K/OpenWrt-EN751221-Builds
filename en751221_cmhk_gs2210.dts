/dts-v1/;

#include "en751221.dtsi"
#include <dt-bindings/input/input.h>
#include <dt-bindings/gpio/gpio.h>

/ {
	model = "China Mobile HK GS2210";
	compatible = "cmhk,gs2210", "econet,en751221";

	memory@0 {
		device_type = "memory";
		reg = <0x00000000 0x20000000>; /* 512MB RAM 實體邊界 */
	};

	chosen {
		stdout-path = "/serial@1fbf0000:115200";
		linux,usable-memory-range = <0x00002000 0x1b7e0000>; /* 440MB 內核沙盒限制 */
	};

	/* 1. 精準對齊 CMHK GS2210 面板印刷的物理 LED 燈陣 */
	gpio-leds {
		compatible = "gpio-leds";

		power {
			label = "green:power";
			gpios = <&gpio0 16 GPIO_ACTIVE_HIGH>;
			default-state = "on";
		};

		wan {
			label = "green:wan";
			gpios = <&gpio0 6 GPIO_ACTIVE_HIGH>;
		};

		wlan2g {
			label = "green:wlan2g";
			gpios = <&gpio0 28 GPIO_ACTIVE_HIGH>;
		};

		wlan5g {
			label = "green:wlan5g";
			gpios = <&gpio0 3 GPIO_ACTIVE_HIGH>;
		};

		wps {
			label = "green:wps";
			gpios = <&gpio0 41 GPIO_ACTIVE_HIGH>;
		};
	};

	/* 2. 物理 Reset 鍵中斷控制器 */
	gpio-keys {
		compatible = "gpio-keys";

		reset {
			label = "reset";
			gpios = <&gpio0 5 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};
	};
};

&nand {
	status = "okay";
	econet,bmt;

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		partition@0 {
			label = "bootloader";
			reg = <0x0 0x40000>;
			read-only;
		};

		partition@40000 {
			label = "romfile";
			reg = <0x40000 0x40000>;
		};

		partition@80000 {
			label = "tclinux";
			reg = <0x80000 0x1000000>;
			econet,enable-remap;
		};

		partition@1080000 {
			label = "tclinux_slave";
			reg = <0x1080000 0x1000000>;
			read-only;
		};

		partition@2080000 {
			label = "osgi";
			reg = <0x2080000 0x3400000>;
		};

		partition@5480000 {
			label = "yaffs";
			reg = <0x5480000 0x8000000>;
		};

		partition@d480000 {
			label = "upgradeflag";
			reg = <0xd480000 0x20000>;
		};

		partition@d4a0000 {
			label = "scdata";
			reg = <0xd4a0000 0x800000>;
		};

		partition@dca0000 {
			label = "reservearea";
			reg = <0xdca0000 0x1c0000>;
			read-only;

			nvmem-layout {
				compatible = "fixed-layout";
				#address-cells = <1>;
				#size-cells = <1>;

				eeprom_reserve_60000: eeprom@60000 {
					reg = <0x60000 0x400>;
				};

				eeprom_reserve_60200: eeprom@60200 {
					reg = <0x60200 0x200>;
				};
			};
		};
	};
};

/* 👈 核心修正三：重寫千兆交換機端口，完美對齊原厂硬體走線 */
&ethernet {
	mdio-bus {
		switch0: switch@1f {
			ports {
				#address-cells = <1>;
				#size-cells = <0>;
				reg = <0>;

				/* 關閉原廠標記為 -1 的懸空邏輯 0 號端口 */
				port@0 {
					status = "disabled";
					reg = <0>;
				};

				/* 精準對齊：內部 Port 1 映射到物理 LAN1 */
				port@1 {
					status = "okay";
					reg = <1>;
					label = "lan1";
				};

				/* 精準對齊：內部 Port 2 映射到物理 LAN2 */
				port@2 {
					status = "okay";
					reg = <2>;
					label = "lan2";
				};

				/* 精準對齊：內部 Port 3 映射到物理 LAN3 */
				port@3 {
					status = "okay";
					reg = <3>;
					label = "lan3";
				};

				/* 保持 CPU 主數據管道總線鎖定在 Port 6 */
				port@6 {
					reg = <6>;
					label = "cpu";
					ethernet = <&gmac0>;
					phy-mode = "trgmii";

					fixed-link {
						speed = <1000>;
						full-duplex;
					};
				};
			};
		};
	};
};

&uart {
	status = "okay";
};

&pcie0 { status = "okay"; };
&slot0 {
	wifi@0,0 {
		compatible = "mediatek,mt76";
		reg = <0x0000 0 0 0 0>;
		nvmem-cells = <&eeprom_reserve_60000>;
		nvmem-cell-names = "eeprom";
	};
};

&pcie1 { status = "okay"; };
&slot1 {
	wifi@0,0 {
		compatible = "mediatek,mt76";
		reg = <0x0000 0 0 0 0>;
		nvmem-cells = <&eeprom_reserve_60200>;
		nvmem-cell-names = "eeprom";
	};
};
